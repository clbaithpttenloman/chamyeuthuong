{
  "name": "cham-yeu-thuong",
  "compatibility_date": "2026-11-01",
  // Build before every deploy, so `npx wrangler deploy` works even when no build command is set in Cloudflare.
  "build": { "command": "npm run build" },
  // Admin auth (Phase 1): Google sign-in via session cookie is the primary path.
  // Legacy X-Admin-Email path (ADMIN_LEGACY_LOGIN="1") stays on for the 20/11 admin routes
  // for the whole campaign platform; removing it is a separate, later feature.
  //
  // Phase 1 secrets (set via `wrangler secret put`):
  //   NONCE_KEY    — 32+ byte random key for HMAC-signing sign-in nonces (required)
  //   SUB_HMAC_KEY — reserved for Phase 2 ban tombstones (not read yet)
  //   IP_HMAC_KEY  — reserved for Phase 2 abuse handling (not read yet)
  //
  // First-admin bootstrap (email header, one-time):
  //   BOOTSTRAP_EMAIL in "vars" lets only that exact address claim an EMPTY admin table.
  //   It is inert once the table is non-empty, so it may remain set indefinitely.
  //   ALLOW_FIRST_CLAIM=1 lets ANY email claim the first admin slot — temporary only,
  //   must be removed immediately after use. Set via `wrangler secret put`, never in "vars".
  //
  // Local dev: add secrets to .dev.vars (never commit). See docs/runbooks/admin.md.
  //
  // The Worker runs only for /api/* (card and admin endpoints); every other path is a static asset from dist/.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Preview URLs would share the D1 binding and could write rows into the live DB (security review).
  "preview_urls": false,
  // Pinned so every deploy (Git or laptop) uses this same database. Not a secret: it only works with the account's credentials.
  "d1_databases": [
    { "binding": "DB", "database_name": "cham-yeu-thuong", "database_id": "9e58f935-fb6f-4c1f-be0b-21a9183ba483" }
  ],
  "vars": {
    // First-admin bootstrap: only this address can claim the empty admin table. Inert once an admin exists.
    "BOOTSTRAP_EMAIL": "clbaithpttenloman@gmail.com",
    // Google OAuth client ID (replace with the real value from Google Cloud Console).
    // Authorised JavaScript origins must include the production domain and https://localhost:5173 for local dev.
    // GOOGLE_CLIENT_ID must end with .apps.googleusercontent.com
    "GOOGLE_CLIENT_ID": "",
    // Phase 1 transition: keep legacy X-Admin-Email login on 20/11 admin routes.
    // Remove before Phase 2 production deploy (see docs/runbooks/admin.md).
    "ADMIN_LEGACY_LOGIN": "1"
  },
  // Secrets required for deploy (set via `wrangler secret put <NAME>`):
  //   NONCE_KEY, SUB_HMAC_KEY, IP_HMAC_KEY
  // Per-IP rate limits (approximate, per Cloudflare location).
  // PUBLIC_IP_LIMIT (120/60 s): guards /api/wall, /api/templates, /api/wishes, /api/about.
  // SUBMIT_IP_LIMIT (20/60 s): guards POST /api/cards (student card submissions).
  // CARD_IP_LIMIT (60/60 s): guards /api/qr/:token; blunts token scanners.
  // ADMIN_FAIL_LIMIT (60/60 s): guards /api/admin/* (all requests).
  // IMAGE_IP_LIMIT (300/60 s): guards /api/image/:token (GET only).
  // AUTH_LIMIT (300/60 s per IP): guards /api/auth/google FAILURES only (not nonces, not successes).
  //   On POST /api/auth/google: charged only when sign-in fails (bad token, wrong nonce, etc.).
  //   On GET /api/auth/nonce: use PUBLIC_READ_LIMIT instead.
  // AUTH_SUB_LIMIT (10/60 s per sub): guards /api/auth/google successful sign-ins; namespace 2009.
  // USER_READ_LIMIT (120/60 s per user id, IP when signed out): guards GET /api/me; namespace 2007.
  // USER_WRITE_LIMIT (10/60 s per user id, IP when signed out): guards PUT /api/me and logout; namespace 2008.
  // PUBLIC_READ_LIMIT (3000/60 s per IP): guards public /api/campaigns/* cache misses; namespace 2010.
  "ratelimits": [
    { "name": "PUBLIC_IP_LIMIT",  "namespace_id": "2004", "simple": { "limit": 120,  "period": 60 } },
    { "name": "SUBMIT_IP_LIMIT",  "namespace_id": "2005", "simple": { "limit": 20,   "period": 60 } },
    { "name": "CARD_IP_LIMIT",    "namespace_id": "2001", "simple": { "limit": 60,   "period": 60 } },
    { "name": "ADMIN_FAIL_LIMIT", "namespace_id": "2002", "simple": { "limit": 60,   "period": 60 } },
    { "name": "IMAGE_IP_LIMIT",   "namespace_id": "2003", "simple": { "limit": 300,  "period": 60 } },
    { "name": "AUTH_LIMIT",       "namespace_id": "2006", "simple": { "limit": 300,  "period": 60 } },
    { "name": "AUTH_SUB_LIMIT",   "namespace_id": "2009", "simple": { "limit": 10,   "period": 60 } },
    { "name": "USER_READ_LIMIT",  "namespace_id": "2007", "simple": { "limit": 120,  "period": 60 } },
    { "name": "USER_WRITE_LIMIT", "namespace_id": "2008", "simple": { "limit": 10,   "period": 60 } },
    { "name": "PUBLIC_READ_LIMIT","namespace_id": "2010", "simple": { "limit": 3000, "period": 60 } }
  ],
  // Staging environment: separate Worker name and D1 database.
  // All bindings and vars are non-inheritable and must be repeated here.
  // ALLOW_FIRST_CLAIM is intentionally NOT set on staging (ADR-3).
  // Replace PLACEHOLDER_D1_DATABASE_ID with the staging DB id from `wrangler d1 create cham-yeu-thuong-staging`.
  "env": {
    "staging": {
      "name": "cham-yeu-thuong-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cham-yeu-thuong-staging",
          "database_id": "PLACEHOLDER_STAGING_D1_DATABASE_ID"
        }
      ],
      "vars": {
        // Replace with the staging OAuth client ID (add staging hostname as an authorised origin).
        "GOOGLE_CLIENT_ID": ""
        // ADMIN_LEGACY_LOGIN and BOOTSTRAP_EMAIL are intentionally absent from staging.
        // Staging admins are seeded with: wrangler d1 execute cham-yeu-thuong-staging --command
        //   "INSERT INTO admin (email, created_at, created_by) VALUES ('you@gmail.com', datetime('now'), 'seed')"
      },
      "ratelimits": [
        { "name": "PUBLIC_IP_LIMIT",  "namespace_id": "3004", "simple": { "limit": 120,  "period": 60 } },
        { "name": "SUBMIT_IP_LIMIT",  "namespace_id": "3005", "simple": { "limit": 20,   "period": 60 } },
        { "name": "CARD_IP_LIMIT",    "namespace_id": "3001", "simple": { "limit": 60,   "period": 60 } },
        { "name": "ADMIN_FAIL_LIMIT", "namespace_id": "3002", "simple": { "limit": 60,   "period": 60 } },
        { "name": "IMAGE_IP_LIMIT",   "namespace_id": "3003", "simple": { "limit": 300,  "period": 60 } },
        { "name": "AUTH_LIMIT",       "namespace_id": "3006", "simple": { "limit": 300,  "period": 60 } },
        { "name": "AUTH_SUB_LIMIT",   "namespace_id": "3009", "simple": { "limit": 10,   "period": 60 } },
        { "name": "USER_READ_LIMIT",  "namespace_id": "3007", "simple": { "limit": 120,  "period": 60 } },
        { "name": "USER_WRITE_LIMIT", "namespace_id": "3008", "simple": { "limit": 10,   "period": 60 } },
        { "name": "PUBLIC_READ_LIMIT","namespace_id": "3010", "simple": { "limit": 3000, "period": 60 } }
      ]
    }
  }
}
