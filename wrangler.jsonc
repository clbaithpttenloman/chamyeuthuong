{
  "name": "cham-yeu-thuong",
  "compatibility_date": "2026-11-01",
  // Build before every deploy, so `npx wrangler deploy` works even when no build command is set in Cloudflare.
  "build": { "command": "npm run build" },
  // Admin auth uses Google Sign-In ID tokens (Authorization: Bearer). No ADMIN_TOKEN.
  // Required public value: GOOGLE_CLIENT_ID (ends with .apps.googleusercontent.com). Set it in "vars" here (see
  // docs/runbooks/admin.md) or with `wrangler secret put`. Never commit the client secret — there is none.
  // Commented example (replace with your real OAuth client ID):
  //   "vars": { "GOOGLE_CLIENT_ID": "123456789-abc.apps.googleusercontent.com", "BOOTSTRAP_EMAIL": "admin@gmail.com" }
  //
  // First-admin bootstrap: BOOTSTRAP_EMAIL (in "vars" or as a secret) lets only that address claim an EMPTY admin table
  // and may stay set. ALLOW_FIRST_CLAIM=1 lets ANY verified Google user claim: set it only temporarily via
  // `wrangler secret put ALLOW_FIRST_CLAIM`, never in "vars", and delete it after the first admin is confirmed.
  //
  // Local dev: AUTH_DEV_MODE=1 and AUTH_DEV_JWKS_URL=http://127.0.0.1:<port>/certs go in .dev.vars only.
  // Never set AUTH_DEV_MODE in production — it must stay absent from this file.
  //
  // The Worker runs only for /api/* (card and admin endpoints); every other path is a static asset from dist/.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Preview URLs would share the D1 binding and could write rows into the live DB (security review).
  "preview_urls": false,
  // Pinned so every deploy (Git or laptop) uses this same database. Not a secret: it only works with the account's credentials.
  "d1_databases": [
    { "binding": "DB", "database_name": "cham-yeu-thuong", "database_id": "9e58f935-fb6f-4c1f-be0b-21a9183ba483" }
  ],
  // Per-IP rate limits. Counts are approximate and per Cloudflare location.
  // CARD_IP_LIMIT: blunts token scanners (school NAT shares one IP → 60 generous).
  // ADMIN_FAIL_LIMIT: guards /api/admin/* per source IP (all requests count, not just failures).
  //   Consequence: multiple admins behind one NAT share the 30/60 s budget — see decisions.md.
  "ratelimits": [
    { "name": "CARD_IP_LIMIT",    "namespace_id": "2001", "simple": { "limit": 60, "period": 60 } },
    { "name": "ADMIN_FAIL_LIMIT", "namespace_id": "2002", "simple": { "limit": 30, "period": 60 } }
  ]
}
