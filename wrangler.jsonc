{
  "name": "cham-yeu-thuong",
  "compatibility_date": "2026-11-01",
  // Build before every deploy, so `npx wrangler deploy` works even when no build command is set in Cloudflare.
  "build": { "command": "npm run build" },
  // Admin auth uses Cloudflare Access JWT (Cf-Access-Jwt-Assertion header). No ADMIN_TOKEN.
  // Required secrets (set via `wrangler secret put`): ACCESS_TEAM_DOMAIN, ACCESS_AUD.
  // ACCESS_DEV_MODE must NOT be set in production — it is for local dev only (.dev.vars).
  //
  // First-admin bootstrap (set ONE of the following for the first deploy, then remove it):
  //   BOOTSTRAP_EMAIL=you@example.com  — only this exact address may claim the first-admin slot
  //   ALLOW_FIRST_CLAIM=1              — any verified Access user may claim the first-admin slot
  // After the first admin is confirmed in /admin, remove the variable and redeploy.
  // ALLOW_FIRST_CLAIM is NEVER left active; it is set only temporarily via `wrangler secret put`.
  //
  // workers_dev: If a custom domain is configured, add "workers_dev": false and redeploy so that
  // the workers.dev URL is disabled (unauthenticated requests still 401 at the Worker, but Access
  // won't protect the .workers.dev hostname). Without a custom domain, create a second Cloudflare
  // Access application covering the <name>.<account>.workers.dev hostname instead.
  //
  // The Worker runs only for /api/* (card and admin endpoints); every other path is a static asset from dist/.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Preview URLs would share the D1 binding and could write rows into the live DB (security review).
  "preview_urls": false,
  // D1 without database_id: Wrangler auto-provisions on first deploy; pin the ID afterwards.
  "d1_databases": [
    { "binding": "DB", "database_name": "cham-yeu-thuong" }
  ],
  // Per-IP rate limits. Counts are approximate and per Cloudflare location.
  // CARD_IP_LIMIT: blunts token scanners (school NAT shares one IP → 60 generous).
  // ADMIN_FAIL_LIMIT: guards /api/admin/* per source IP (all requests count, not just failures).
  //   Consequence: multiple admins behind one NAT share the 30/60 s budget — see decisions.md.
  "ratelimits": [
    { "name": "CARD_IP_LIMIT",    "namespace_id": "2001", "simple": { "limit": 60, "period": 60 } },
    { "name": "ADMIN_FAIL_LIMIT", "namespace_id": "2002", "simple": { "limit": 30, "period": 60 } }
  ]
}
