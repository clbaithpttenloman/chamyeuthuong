{
  "name": "cham-yeu-thuong",
  "compatibility_date": "2026-11-01",
  // Build before every deploy, so `npx wrangler deploy` works even when no build command is set in Cloudflare.
  "build": { "command": "npm run build" },
  // Static assets only. No Worker: unknown paths fall back to index.html (React Router handles /t/:id).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "preview_urls": false
}
