{
  "name": "cham-yeu-thuong",
  "compatibility_date": "2026-11-01",
  // Build before every deploy, so `npx wrangler deploy` works even when no build command is set in Cloudflare.
  "build": { "command": "npm run build" },
  // Admin auth uses a typed email sent as X-Admin-Email on every /api/admin/* request.
  // The email is checked against the D1 admin list; identity is not verified (accepted risk R1, see docs/runbooks/admin.md).
  //
  // First-admin bootstrap:
  //   BOOTSTRAP_EMAIL (in "vars" or as a secret) lets only that exact address claim an EMPTY admin table.
  //   It may stay set; it is inert once the table is non-empty.
  //
  //   ALLOW_FIRST_CLAIM=1 lets ANY email claim the first admin slot (temporary only, delete after).
  //   Set only via `wrangler secret put`, never in "vars".
  //
  // Local dev: add to .dev.vars (never commit). See docs/runbooks/admin.md.
  //
  // The Worker runs only for /api/* (card and admin endpoints); every other path is a static asset from dist/.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Preview URLs would share the D1 binding and could write rows into the live DB (security review).
  "preview_urls": false,
  // Pinned so every deploy (Git or laptop) uses this same database. Not a secret: it only works with the account's credentials.
  "d1_databases": [
    { "binding": "DB", "database_name": "cham-yeu-thuong", "database_id": "9e58f935-fb6f-4c1f-be0b-21a9183ba483" }
  ],
  // Only this address can claim the empty admin table (first-admin bootstrap). Not a secret; inert once an admin exists.
  "vars": {
    "BOOTSTRAP_EMAIL": "clbaithpttenloman@gmail.com"
  },
  // Per-IP rate limits (approximate, per Cloudflare location).
  // PUBLIC_IP_LIMIT (120/60 s): guards /api/wall, /api/teachers/*, /api/templates, /api/wishes.
  //   120/min is generous; school NAT shares one IP, so set high enough to avoid false positives.
  // SUBMIT_IP_LIMIT (20/60 s): guards POST /api/cards (student card submissions).
  //   20/min is tight for a school NAT on 20/11 — raise in .dev.vars for the event if needed.
  //   See docs/runbooks/admin.md for how to raise.
  // CARD_IP_LIMIT (60/60 s): guards /api/qr/:token; blunts token scanners.
  //   School NAT = many viewers on one IP; 60/60 is generous.
  // ADMIN_FAIL_LIMIT (60/60 s): guards /api/admin/* (all requests); was 30/60, raised to 60/60 for upload sessions.
  //   Upload workflows make many API calls (list, upload, attach, preview, publish).
  //   Side effect (R1): rate limit is the only brake on guessing admin emails (risk accepted, see decisions.md).
  //   Consequence: multiple admins behind one NAT share the 60/60 s budget; busy editing may hit the limit.
  // IMAGE_IP_LIMIT (300/60 s): guards /api/image/:token (GET only); 300/60 allows fast card loads while blunting scanners.
  "ratelimits": [
    { "name": "PUBLIC_IP_LIMIT",  "namespace_id": "2004", "simple": { "limit": 120, "period": 60 } },
    { "name": "SUBMIT_IP_LIMIT",  "namespace_id": "2005", "simple": { "limit": 20,  "period": 60 } },
    { "name": "CARD_IP_LIMIT",    "namespace_id": "2001", "simple": { "limit": 60,  "period": 60 } },
    { "name": "ADMIN_FAIL_LIMIT", "namespace_id": "2002", "simple": { "limit": 60,  "period": 60 } },
    { "name": "IMAGE_IP_LIMIT",   "namespace_id": "2003", "simple": { "limit": 300, "period": 60 } }
  ]
}
